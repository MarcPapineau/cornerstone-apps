# =====================================================================
# My Vitalis Health (my-vitalis-health) — app-local .gitignore
# Canonical product. Keeps build output, deps, runtime state, agent
# scratch, and rename-safety backups out of version control.
# =====================================================================

# --- Build output (regenerated by `npm run build`) ---
dist/

# --- Dependencies ---
node_modules/

# --- Runtime store (server mutates this at runtime; it re-seeds from
#     @vitalis/protocol-core/data/demo-clients on first boot — never commit live state) ---
data/store.json
data/store.json.bak

# --- Local agent / tooling scratch ---
.claude/

# --- Rename-safety backups (2026-06-01 health rename) and any future *.BACKUP-* copies ---
*.BACKUP-*
**/*.BACKUP-*

# --- Playwright visual-QA transient output (traces/diffs/report). Baselines under
#     tests/visual/__screenshots__/ ARE committed; only the .output scratch is ignored. ---
tests/visual/.output/

# --- Local env (defense in depth; also covered by root .gitignore) ---
.env
.env.local
.env.*.local
