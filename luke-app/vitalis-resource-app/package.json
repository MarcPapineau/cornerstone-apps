{
  "name": "my-vitalis-health",
  "version": "0.1.0-mvp",
  "private": true,
  "description": "My Vitalis Health app and dashboard — multi-tenant practitioner/client health resource platform on @vitalis/protocol-core. Server-authoritative gates, React surface. NOT medical advice.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "api": "node server.js",
    "dev": "vite",
    "dev:all": "concurrently -k -n api,web -c blue,magenta \"PORT=3100 node server.js\" \"vite --port 5173 --strictPort\"",
    "prebuild": "node scripts/check-catalog-guard.cjs && node test/acceptance.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "legacy:import": "node scripts/legacy-import.mjs",
    "check:catalog": "node scripts/check-catalog-guard.cjs",
    "test": "node test/acceptance.js",
    "test:visual": "playwright test --config=playwright.vitalis.config.cjs",
    "test:visual:update": "playwright test --config=playwright.vitalis.config.cjs --update-snapshots",
    "test:visual:report": "playwright show-report tests/visual/.output/report"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@vitalis/protocol-core": "file:../../packages/protocol-core",
    "express": "^4.18.2",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
